{
  "name": "bundle-fingerprinting",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "test": "pnpm run typecheck && pnpm run test:node",
    "test:node": "node --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --ignore-path .oxlintignore",
    "format": "oxfmt --write '**/*.{ts,js,css,html,json}'",
    "preflight": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "bin": {
    "fingerprint-bundle": "./match-bundle"
  },
  "dependencies": {
    "axios": "latest",
    "d3": "latest",
    "lodash-es": "latest",
    "moment": "latest"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "latest",
    "@rollup/plugin-node-resolve": "latest",
    "@rollup/plugin-terser": "latest",
    "@swc/core": "^1.15.18",
    "esbuild": "latest",
    "oxc-parser": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "rollup": "latest",
    "source-map": "latest",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.4.0",
    "typescript": "latest",
    "uglify-js": "^3.19.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  }
}
